# GST Bro Server Environment Variables (Example Template)
# DO NOT PUT REAL SECRETS IN THIS FILE

PORT=3001
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Email Provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=GSTBro <noreply@gstbro.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive Integration
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Domain & CORS
SITE_URL=https://gstbro.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# OTP Provider Selection & Cryptographic Hash Secret
OTP_PROVIDER=apitxt
OTP_HASH_SECRET=

# APITxT Unified OTP API Configuration (Server-Side Only)
APITXT_AUTHKEY=
APITXT_SMS_TEMPLATE_ID=
APITXT_API_BASE_URL=https://apitxt.com/api

# 2Factor.in SMS Configuration (Fallback Provider)
TWOFACTOR_API_KEY=
TWOFACTOR_API_BASE_URL=https://2factor.in/API/V1
TWOFACTOR_TEMPLATE_NAME=

# Security & Cloudflare
TRUST_PROXY=true
CLOUDFLARE_ORIGIN_SECRET=
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFYp9o1y6TliVyNr
TURNSTILE_SECRET_KEY=0x4AAAAAAFYp9t_6XeDnlYFJq_JNP9mC1ZE
REDIS_URL=
